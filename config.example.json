{
  "namespaces": ["tecopos"],
  "intervalo_segundos": 60,
  "timeout_sonda_segundos": 3,

  "_comentario_alias": "Valores de EJEMPLO. El mapa real de cada clúster vive en su propio ConfigMap, no aquí.",
  "alias": {
    "10.0.0.10:5432":   "postgres-principal",
    "10.0.0.10:31878":  "controlserver (NodePort)",
    "10.0.0.10:31821":  "hermes-server (NodePort)",
    "10.0.0.10":        "nodo-10.0.0.10",
    "10.0.0.11":        "kafka-minio",
    "10.0.0.12":        "apiv1-instancia-0",
    "10.0.0.13":        "apiv1-instancia-1",
    "203.0.113.20":     "pasarela-pagos",
    "emqx-svc.brokers": "emqx (brokers)",
    "mqtt.example.com": "broker-mqtt",
    "o0000000000000000.ingest.us.sentry.io": "sentry"
  },

  "no_sondear": [],

  "_comentario_protocolos": "Fuerza la sonda cuando el puerto no delata el protocolo. Un NodePort 31878 no parece gRPC, pero lo es.",
  "protocolos": {
    "10.0.0.10:31878": "grpc",
    "10.0.0.10:31821": "grpc",
    "10.0.0.10:32272": "grpc"
  },
  "protocolo_por_puerto": {
    "9000": "http"
  },

  "hosts_ignorar": ["0.0.0.0", "127.0.0.1", "localhost", "::", "::1"],
  "claves_regex": "(HOST|HOSTS|URL|URLS|URI|ADDR|ADDRESS|ENDPOINT|BROKER|BROKERS|SERVER)$",
  "claves_excluir_regex": "(CORS|ORIGIN|ALLOWLIST|WHITELIST|PUBLIC|DOMAIN|THIS_URL|REDIRECT|_WEB_URL$|PORTAL_BASE_URL)",
  "prefijos_navegador": ["VITE_", "REACT_APP_", "NEXT_PUBLIC_", "VUE_APP_"],
  "incluir_navegador": false
}
